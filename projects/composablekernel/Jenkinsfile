// Simplified Composable Kernel Jenkins Pipeline
// Purpose: Demonstrate cross-architecture compilation
// Build on gfx908 targeting gfx950, then run test on gfx950

ck = null

def rocmnode(name) {
    return '(rocmtest || miopen) && (' + name + ')'
}

def loadCk() {
    if (ck == null) {
        checkout scm
        dir("projects/composablekernel") {
            ck = load "vars/ck.groovy"
        }
    }
}

pipeline {
    agent none

    options {
        skipDefaultCheckout()
        timestamps()
    }

    parameters {
        string(
            name: 'ROCMVERSION',
            defaultValue: '7.13',
            description: 'ROCm version to use (default: 7.13)')
        string(
            name: 'BUILD_COMPILER',
            defaultValue: '/opt/rocm/llvm/bin/clang++',
            description: 'Compiler path (default: /opt/rocm/llvm/bin/clang++)')
        string(
            name: 'USE_CUSTOM_DOCKER',
            defaultValue: '',
            description: 'Custom docker image to use (leave blank for default)')
        string(
            name: 'COMPILER_VERSION',
            defaultValue: '',
            description: 'Compiler version suffix (leave blank for default): develop, amd-staging, therock')
        string(
            name: 'COMPILER_COMMIT',
            defaultValue: '',
            description: 'Compiler commit hash (leave blank for latest)')
        booleanParam(
            name: 'BUILD_INSTANCES_ONLY',
            defaultValue: false,
            description: 'Set to true if only building (no GPU needed)')
        string(
            name: 'CTEST_PARALLEL',
            defaultValue: '8',
            description: 'Number of parallel test jobs for ctest (default: 8)')
    }

    environment {
        // Use CK_DOCKERHUB from Jenkins env, or fall back to default if not set
        CK_DOCKERHUB = "${env.CK_DOCKERHUB ?: 'rocm/composable_kernel'}"
    }

    stages {
        stage('Build for gfx950 on gfx908') {
            agent { label rocmnode("gfx908") }
            steps {
                script {
                    echo "=== Building all CK tests for gfx950 on gfx908 node ==="

                    // Load helper functions and checkout code
                    loadCk()
                    ck.checkoutComposableKernel()

                    // Get Docker image and options
                    def (retimage, image) = ck.getDockerImage()
                    def dockerOpts = ck.get_docker_options()

                    echo "Using Docker image: ${image}"
                    echo "Docker options: ${dockerOpts}"

                    // Build specific tests inside Docker container
                    withDockerContainer(image: image, args: dockerOpts) {
                        sh """#!/bin/bash
                            set -ex
                            cd projects/composablekernel

                            # Clean and create build directory
                            rm -rf build
                            mkdir build
                            cd build

                            # Configure CMake to target gfx950
                            cmake -G Ninja \
                                -DCMAKE_CXX_COMPILER="${params.BUILD_COMPILER}" \
                                -DCMAKE_HIP_COMPILER="${params.BUILD_COMPILER}" \
                                -DGPU_TARGETS=gfx950 \
                                -DCMAKE_BUILD_TYPE=Release \
                                -DCMAKE_PREFIX_PATH=/opt/rocm \
                                ..

                            # Build only specific tests (faster for testing)
                            echo "Building specific tests..."
                            ninja -j\$(nproc) test_ck_tile_streamk_tile_partitioner test_ck_tile_streamk_linear_smoke

                            # Show what was built
                            echo "Built binaries:"
                            ls -lh bin/
                        """
                    }

                    // Stash the entire build directory (includes binaries, libs, and CTest files)
                    dir("projects/composablekernel") {
                        echo "Stashing entire build directory..."
                        stash name: 'gfx950-build-dir', includes: 'build/**'

                        // Check stash size
                        sh """
                            echo "Build directory size:"
                            du -sh build/
                        """
                    }

                    echo "Successfully built and stashed all tests"
                }
            }
            post {
                always {
                    cleanWs()
                }
            }
        }

        stage('Test on gfx950') {
            agent { label rocmnode("gfx950") }
            steps {
                script {
                    echo "=== Running all CK tests on gfx950 node ==="

                    // Load helper functions (does minimal checkout for groovy file)
                    loadCk()

                    // Use existing helper functions to get Docker image and options
                    def (retimage, image) = ck.getDockerImage()
                    def dockerOpts = ck.get_docker_options()

                    echo "Using Docker image: ${image}"
                    echo "Docker options: ${dockerOpts}"

                    // Unstash the entire build directory in the correct context
                    echo "Unstashing build directory..."
                    dir("projects/composablekernel") {
                        unstash 'gfx950-build-dir'

                        // Verify unstash worked
                        sh """
                            echo "Verifying unstash:"
                            ls -la
                            echo "Build directory exists:"
                            ls -la build/ | head -10
                        """
                    }

                    // Run all tests with ctest in the Docker container
                    withDockerContainer(image: image, args: dockerOpts) {
                        sh """#!/bin/bash
                            set -ex

                            # Verify GPU is accessible
                            echo "Checking GPU availability:"
                            rocminfo | grep -i gfx950

                            # Navigate to build directory
                            cd projects/composablekernel/build

                            # Verify build directory contents
                            echo "Build directory contents:"
                            ls -lh

                            # Run only the specific tests we built with ctest
                            echo "Running specific tests with ctest..."
                            ctest -R "test_ck_tile_streamk_tile_partitioner|test_ck_tile_streamk_linear_smoke" \
                                  -j${params.CTEST_PARALLEL} \
                                  --output-on-failure

                            echo "Tests completed successfully!"
                        """
                    }
                }
            }
            post {
                always {
                    cleanWs()
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully!"
            echo "  - Built all CK tests on gfx908 targeting gfx950"
            echo "  - Executed all tests on gfx950 with ctest"
        }
        failure {
            echo "Pipeline failed"
        }
    }
}
