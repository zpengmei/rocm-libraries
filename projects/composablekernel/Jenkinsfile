// Simplified Composable Kernel Jenkins Pipeline
// Purpose: Demonstrate cross-architecture compilation with smart build/test
// Build on cpu-only targeting gfx950, then run test on gfx950
// Uses smart_build.sh and smart_test.sh for intelligent selective testing

ck = null

def rocmnode(name) {
    return '(rocmtest || miopen) && (' + name + ')'
}

def loadCk() {
    if (ck == null) {
        checkout scm
        dir("projects/composablekernel") {
            ck = load "vars/ck.groovy"
        }
    }
}

pipeline {
    agent none

    options {
        skipDefaultCheckout()
        timestamps()
    }

    parameters {
        string(
            name: 'ROCMVERSION',
            defaultValue: '7.13',
            description: 'ROCm version to use (default: 7.13)')
        string(
            name: 'BUILD_COMPILER',
            defaultValue: '/opt/rocm/llvm/bin/clang++',
            description: 'Compiler path (default: /opt/rocm/llvm/bin/clang++)')
        string(
            name: 'USE_CUSTOM_DOCKER',
            defaultValue: '',
            description: 'Custom docker image to use (leave blank for default)')
        string(
            name: 'COMPILER_VERSION',
            defaultValue: '',
            description: 'Compiler version suffix (leave blank for default): develop, amd-staging, therock')
        string(
            name: 'COMPILER_COMMIT',
            defaultValue: '',
            description: 'Compiler commit hash (leave blank for latest)')
        booleanParam(
            name: 'BUILD_INSTANCES_ONLY',
            defaultValue: false,
            description: 'Set to true if only building (no GPU needed)')
        string(
            name: 'CTEST_PARALLEL',
            defaultValue: '8',
            description: 'Number of parallel test jobs for ctest (default: 8)')
        booleanParam(
            name: 'DISABLE_SMART_BUILD',
            defaultValue: false,
            description: 'Disable smart build and force full build/test (default: OFF)')
    }

    environment {
        // Use CK_DOCKERHUB from Jenkins env, or fall back to default if not set
        CK_DOCKERHUB = "${env.CK_DOCKERHUB ?: 'rocm/composable_kernel'}"
    }

    stages {
        stage('Build for gfx950 on cpu-only') {
            agent { label rocmnode("gfx906") }
            steps {
                script {
                    echo "=== Smart Build for gfx950 on cpu-only node ==="

                    // Load helper functions and checkout code
                    loadCk()
                    ck.checkoutComposableKernel()

                    // Get Docker image and options
                    def (retimage, image) = ck.getDockerImage()
                    def dockerOpts = ck.get_docker_options()

                    echo "Using Docker image: ${image}"
                    echo "Docker options: ${dockerOpts}"

                    // Determine if smart build should run
                    def runAllTests = params.DISABLE_SMART_BUILD

                    // Build using smart build system
                    withDockerContainer(image: image, args: dockerOpts) {
                        sh """#!/bin/bash
                            set -ex
                            cd projects/composablekernel

                            # Clean and create build directory
                            rm -rf build
                            mkdir build
                            cd build

                            # Configure CMake to target gfx950 with compile commands for smart build
                            cmake -G Ninja \
                                -DCMAKE_CXX_COMPILER="${params.BUILD_COMPILER}" \
                                -DCMAKE_HIP_COMPILER="${params.BUILD_COMPILER}" \
                                -DGPU_TARGETS=gfx950 \
                                -DCMAKE_BUILD_TYPE=Release \
                                -DCMAKE_PREFIX_PATH=/opt/rocm \
                                -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
                                ..

                            # Set environment variables for smart build
                            export WORKSPACE_ROOT=${env.WORKSPACE}/projects/composablekernel
                            export BUILD_DIR=\$(pwd)
                            export NINJA_JOBS=\$(nproc)
                            export ARCH_NAME=gfx950
                            export PARALLEL=32
                            export CTEST_PARALLEL=${params.CTEST_PARALLEL}

                            if [ "${runAllTests}" = "true" ]; then
                                echo "Smart build disabled - building all tests..."
                                ninja -j\$(nproc) tests examples
                                # Create build_mode.env for smart_test.sh
                                echo "SMART_BUILD_MODE=full" > build_mode.env
                            else
                                echo "Running smart build system..."
                                bash ../script/dependency-parser/smart_build.sh
                            fi

                            # Show build results
                            echo "Build artifacts:"
                            ls -la
                            if [ -f build_mode.env ]; then
                                echo "Build mode:"
                                cat build_mode.env
                            fi
                            if [ -f build_targets.txt ]; then
                                echo "Build targets:"
                                cat build_targets.txt
                            fi
                            if [ -f tests_to_run.json ]; then
                                echo "Tests to run summary:"
                                jq -r '.tests_to_run | length' tests_to_run.json || echo "N/A"
                            fi
                        """
                    }

                    // Stash only the build directory (test node will checkout repo for source/scripts)
                    dir("projects/composablekernel") {
                        echo "Stashing build directory..."
                        stash name: 'gfx950-build-dir', includes: 'build/**'

                        // Check stash size
                        sh """
                            echo "Build directory size:"
                            du -sh build/
                        """
                    }

                    echo "Successfully built and stashed"
                }
            }
            post {
                always {
                    cleanWs()
                }
            }
        }

        stage('Test on gfx950') {
            agent { label rocmnode("gfx950") }
            steps {
                script {
                    echo "=== Smart Test on gfx950 node ==="

                    // Checkout repo (needed for source code, scripts, and python tests)
                    loadCk()
                    ck.checkoutComposableKernel()

                    // Use existing helper functions to get Docker image and options
                    def (retimage, image) = ck.getDockerImage()
                    def dockerOpts = ck.get_docker_options()

                    echo "Using Docker image: ${image}"
                    echo "Docker options: ${dockerOpts}"

                    // Unstash the build directory into projects/composablekernel/build/
                    echo "Unstashing build directory..."
                    dir("projects/composablekernel") {
                        unstash 'gfx950-build-dir'

                        // Verify unstash worked and show smart build artifacts
                        sh """
                            echo "Verifying unstash:"
                            ls -la build/ | head -15

                            if [ -f build/build_mode.env ]; then
                                echo "Build mode from build stage:"
                                cat build/build_mode.env
                            fi
                        """
                    }

                    // Run tests using smart test system
                    withDockerContainer(image: image, args: dockerOpts) {
                        sh """#!/bin/bash
                            set -ex

                            # Verify GPU is accessible
                            echo "Checking GPU availability:"
                            rocminfo | grep -i gfx950

                            # Navigate to build directory
                            cd projects/composablekernel/build

                            # Set environment variables for smart test
                            export BUILD_DIR=\$(pwd)
                            export CTEST_PARALLEL=${params.CTEST_PARALLEL}

                            # Run smart test system (reads build_mode.env and runs appropriate tests)
                            echo "Running smart test system..."
                            bash ../script/dependency-parser/smart_test.sh

                            echo "Tests completed successfully!"
                        """
                    }
                }
            }
            post {
                always {
                    cleanWs()
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully!"
            echo "  - Smart build on cpu-only targeting gfx950"
            echo "  - Smart test on gfx950"
            echo "  - Smart build system determined affected tests and ran them efficiently"
        }
        failure {
            echo "Pipeline failed"
        }
    }
}
